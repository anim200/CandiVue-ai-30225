# Copy this file to .env and fill in your own values.
# Never commit .env. This file holds placeholders only.

# App
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (letters and digits only: these values are used inside a URL)
POSTGRES_USER=candivue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=candivue

# Backend port on your machine (bound to localhost only)
BACKEND_PORT=8000

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Frontend port on your machine (bound to localhost only). If you change it,
# change the port in CORS_ORIGINS too.
FRONTEND_PORT=5173

# Optional HTTPS (only when certs/cert.pem and certs/key.pem exist, see
# README "Transport security"). Keep 127.0.0.1 unless you need to open the
# app from a phone on your network; plain HTTP always stays on localhost.
HTTPS_PORT=5443
HTTPS_BIND_ADDRESS=127.0.0.1

# Login tokens. JWT_SECRET signs every token: use a long random value, at
# least 32 characters. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480

# First interviewer account, created when the backend starts and no account
# exists yet. Change the password (8+ characters). Synthetic details only.
DEMO_INTERVIEWER_EMAIL=interviewer.a@example.com
DEMO_INTERVIEWER_NAME=Interviewer A
DEMO_INTERVIEWER_PASSWORD=change-me-please

# AI model. Default: Google Gemini (free key from Google AI Studio).
# To switch, e.g. to OpenAI: LLM_PROVIDER=openai, LLM_MODEL=<model name>,
# and add the matching langchain package to backend/requirements.txt.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
# Models the interviewer can switch to under the chat (each has its own free quota).
LLM_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 0 = repeatable answers (needed for stable candidate scores)
LLM_TEMPERATURE=0

# Knowledge base embeddings. Default: a local model in Docker (Ollama), so
# document text never leaves this machine. To use Gemini instead (same key
# as above): EMBEDDING_PROVIDER=google_genai, EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Local model for CV screening: reads the years of experience when a CV has
# no readable job dates, and checks a missing must-have once more before a
# candidate is excluded. Runs in Ollama (about 2.5 GB); no quota.
SCREENING_MODEL=qwen3:4b-instruct
# Largest knowledge-base document accepted (MB).
MAX_UPLOAD_MB=20

# Job board (Blogger), used only by the jobboard-mcp container. Leave empty
# until you set it up (README "Job board (Blogger)"); posting then shows a
# clear "not set up" message. Use a PRIVATE blog (no real applicants, N13).
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# CV Collector (cv-collector container, README "CV Collector (Google Drive)").
# Read-only service account key: the JSON key on one line, or base64 of it.
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID of the Google Form's response Sheet (from its address: /d/<ID>/edit).
CV_RESPONSES_SHEET_ID=
# Form question "Position applied for" (from a pre-filled link), e.g. entry.123456789
GOOGLE_FORM_POSITION_FIELD=
CV_COLLECT_INTERVAL_SECONDS=300
# Largest CV accepted (MB).
MAX_CV_MB=10
