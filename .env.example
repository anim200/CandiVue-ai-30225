# Copy this file to .env and fill in your own values.
# Never commit .env. This file holds placeholders only.

# App
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (letters and digits only: these values are used inside a URL)
POSTGRES_USER=candivue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=candivue

# Backend port on your machine (bound to localhost only)
BACKEND_PORT=8000

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Frontend port on your machine (bound to localhost only). If you change it,
# change the port in CORS_ORIGINS too.
FRONTEND_PORT=5173

# Optional HTTPS (only when certs/cert.pem and certs/key.pem exist, see
# README "Transport security"). Keep 127.0.0.1 unless you need to open the
# app from a phone on your network; plain HTTP always stays on localhost.
HTTPS_PORT=5443
HTTPS_BIND_ADDRESS=127.0.0.1

# Login tokens. JWT_SECRET signs every token: use a long random value, at
# least 32 characters. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480

# First interviewer account, created when the backend starts and no account
# exists yet. Change the password (8+ characters). Synthetic details only.
DEMO_INTERVIEWER_EMAIL=interviewer.a@example.com
DEMO_INTERVIEWER_NAME=Interviewer A
DEMO_INTERVIEWER_PASSWORD=change-me-please

# AI model. Default: Google Gemini (free key from Google AI Studio).
# To switch, e.g. to OpenAI: LLM_PROVIDER=openai, LLM_MODEL=<model name>,
# and add the matching langchain package to backend/requirements.txt.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 0 = repeatable answers (needed for stable candidate scores)
LLM_TEMPERATURE=0

# Knowledge base: embedding model (same key as above) and largest upload.
EMBEDDING_MODEL=gemini-embedding-001
MAX_UPLOAD_MB=20
