# Copy this file to .env and fill in your own values.
# Never commit .env. This file holds placeholders only.

# App
APP_ENV=development
LOG_LEVEL=INFO
# Time zone for application deadlines and interview times (IANA name)
APP_TIMEZONE=Asia/Dhaka

# PostgreSQL (letters and digits only: these values are used inside a URL)
POSTGRES_USER=candivue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=candivue

# Backend port on your machine (bound to localhost only)
BACKEND_PORT=8000

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Frontend port on your machine (bound to localhost only). If you change it,
# change the port in CORS_ORIGINS too.
FRONTEND_PORT=5173

# Optional HTTPS (only when certs/cert.pem and certs/key.pem exist, see
# README "Transport security"). Keep 127.0.0.1 unless you need to open the
# app from a phone on your network; plain HTTP always stays on localhost.
HTTPS_PORT=5443
HTTPS_BIND_ADDRESS=127.0.0.1

# Login tokens. JWT_SECRET signs every token: use a long random value, at
# least 32 characters. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480

# First interviewer account, created when the backend starts and no account
# exists yet. Change the password (8+ characters). Synthetic details only.
DEMO_INTERVIEWER_EMAIL=interviewer.a@example.com
DEMO_INTERVIEWER_NAME=Interviewer A
DEMO_INTERVIEWER_PASSWORD=change-me-please

# AI model. Default: Google Gemini (free key from Google AI Studio).
# To switch, e.g. to OpenAI: LLM_PROVIDER=openai, LLM_MODEL=<model name>,
# and add the matching langchain package to backend/requirements.txt.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
# Models the interviewer can switch to under the chat (each has its own free quota).
LLM_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 0 = repeatable answers (needed for stable candidate scores)
LLM_TEMPERATURE=0

# Knowledge base embeddings. Default: a local model in Docker (Ollama), so
# document text never leaves this machine. To use Gemini instead (same key
# as above): EMBEDDING_PROVIDER=google_genai, EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
# AI checks in CV screening: read the years of experience when a CV has no
# readable job dates, and check a missing must-have once more before a
# candidate is excluded. Gemini first (uses LLM_API_KEY; the cheapest model;
# CV sent without name, email, phone or links), the local model (Ollama,
# about 2.5 GB, no quota) when there is no key, the quota is used up or
# Gemini fails. Leave SCREENING_AI_MODEL empty to use only the local model.
SCREENING_AI_MODEL=gemini-3.5-flash-lite
SCREENING_MODEL=qwen3:4b-instruct
# Largest knowledge-base document accepted (MB).
MAX_UPLOAD_MB=20

# Job board (Blogger), used only by the jobboard-mcp container. Leave empty
# until you set it up (README "Job board (Blogger)"); posting then shows a
# clear "not set up" message. Use a PRIVATE blog (no real applicants, N13).
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# Email (email-mcp container, README "Email"): interview invitations. Use a
# Gmail account with 2-step verification and an app password. Leave empty
# until set up; invitations then show "Invitation failed: not set up".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=CandiVue Hiring
# While testing, send EVERY email to this address instead of the candidate
# (the subject says who it was for). Keep it set until the final demo (N13).
EMAIL_TEST_RECIPIENT=
# Where candidates open their interview link (this app's address).
APP_PUBLIC_URL=http://localhost:5173

# Calendar (calendar-mcp container, README "Calendar"): the interviewer's
# Google Calendar. Busy times are checked before interview times are
# suggested, and every sent interview is added there. Leave empty until set
# up; scheduling then works without the calendar check (with a warning).
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=
# "primary" = the account's main calendar.
CALENDAR_ID=primary

# Video calls (livekit container, README "Video calls"). The secret signs
# every room ticket and webhook: 32+ random characters, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_API_KEY=candivue
LIVEKIT_API_SECRET=
# Only change these to join from another device on your network (README).
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_BIND_ADDRESS=127.0.0.1

# Live transcript (transcriber container, README "Live transcript"). A
# Deepgram API key (deepgram.com, free credit for new accounts). Only the
# transcriber gets it. Empty: the room says speech-to-text is not set up.
DEEPGRAM_API_KEY=
# Deepgram's model and language (nova-3 / en; "multi" for mixed languages).
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# Identity check (F7, README "Identity check"): the key that encrypts the
# invited applicants' face photos (embedding + small copy). Make one with:
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty: the identity check is off and candidates are not asked.
FACE_REFERENCE_KEY=
# Face photos are deleted this many days after the interview.
FACE_RETENTION_DAYS=30
# Face similarity (0-1) from which the check-in matches the application
# photo (SFace's own same-person line is 0.363), and below which it is
# clearly another person. Shown to the interviewer as 60 % and 40 %.
FACE_MATCH_FROM=0.363
FACE_UNSURE_FROM=0.28

# CV Collector (cv-collector container, README "CV Collector (Google Drive)").
# Read-only service account key: the JSON key on one line, or base64 of it.
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID of the Google Form's response Sheet (from its address: /d/<ID>/edit).
CV_RESPONSES_SHEET_ID=
# Form question "Position applied for" (from a pre-filled link), e.g. entry.123456789
GOOGLE_FORM_POSITION_FIELD=
CV_COLLECT_INTERVAL_SECONDS=300
# Talent rediscovery (F11): applications older than this many days are not
# matched to other vacancies.
REDISCOVERY_MAX_AGE_DAYS=365
# Largest CV accepted (MB).
MAX_CV_MB=10
